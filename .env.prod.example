# Copy this shape into the GitHub Actions secret OPTIMUS_PROD_ENV.
# Never commit a populated production environment file.
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://optimus-code-ui.vercel.app,https://optimusco.de,https://www.optimusco.de
SIGNUP_ENABLED=false

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres

# Set DB_DRIVER=native only after the RDS restore and adapter parity gates pass.
DB_DRIVER=supabase
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=optimus
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional admin API: a dedicated secret generated with openssl rand -hex 32.
# Blank disables admin routes. Keep this out of frontend environment variables.
ADMIN_API_KEY=

DAILY_DSA_TARGET=3
DAILY_LLD_TARGET=1
DAILY_HLD_TARGET=1

GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

LLM_API_KEY=
# Only for gateways that scope a key to a workspace; sent as x-workspace-id.
LLM_WORKSPACE_ID=
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3-contributor

CODE_RUNNER_PROVIDER=judge0
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_MONTHLY_PRODUCT_ID=
DODO_ANNUAL_PRODUCT_ID=

EMAIL_TRANSPORT=smtp
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_SECURE=false
EMAIL_DELIVERY_ENABLED=true
EMAIL_FROM="Optimus Code <no-reply@optimusco.de>"
# Owner-facing reports and feedback are delivered here; user notifications
# continue to use the recipient's own address.
SUPPORT_EMAIL=info@optimusco.de
EMAIL_REPLY_TO=
APP_URL=https://optimusco.de
INVITE_TOKEN_TTL_HOURS=168
STREAK_WARNING_HOUR=22
EMAIL_WORKER_INTERVAL_MIN=15

# Research pipeline — Firecrawl does search + scrape; Browser Use is the
# escalation for hosts Firecrawl refuses (Reddit).
FIRECRAWL_API_KEY=
BROWSER_USE_API_KEY=
RESEARCH_MAX_SEARCHES=8
RESEARCH_MAX_FETCHES=10
RESEARCH_CONCURRENCY=3
RESEARCH_TIMEOUT_MIN=8
RESEARCH_AUTO_PUBLISH=false

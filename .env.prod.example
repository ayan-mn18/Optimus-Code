# Copy this shape into the GitHub Actions secret OPTIMUS_PROD_ENV.
# Never commit a populated production environment file.
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://optimus-code-ui.vercel.app
SIGNUP_ENABLED=false

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

DAILY_DSA_TARGET=3
DAILY_LLD_TARGET=1
DAILY_HLD_TARGET=1

GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_WORKSPACE_ID=
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-3-5-haiku-latest

CODE_RUNNER_PROVIDER=judge0
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_MONTHLY_PRODUCT_ID=
DODO_ANNUAL_PRODUCT_ID=

EMAIL_TRANSPORT=smtp
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_SECURE=false
EMAIL_DELIVERY_ENABLED=true
EMAIL_FROM="Optimus Code <notifications@your-domain.example>"
EMAIL_REPLY_TO=
APP_URL=https://optimus-code-ui.vercel.app
INVITE_TOKEN_TTL_HOURS=168
STREAK_WARNING_HOUR=20
EMAIL_WORKER_INTERVAL_MIN=15

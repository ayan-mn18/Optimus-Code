# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SIGNUP_ENABLED=false

# Supabase — Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed to run the schema from the CLI (`npm run db:apply`).
# Project Settings > Database > Database password.
# SUPABASE_DB_PASSWORD=your-database-password
# Or a full connection string — use this if your network is IPv4-only and you
# need the pooler host instead of db.<ref>.supabase.co.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Challenge defaults
DAILY_TARGET=5

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Supabase — Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database access. Keep `supabase` during the migration; set `native` with the
# RDS connection values only after the PostgreSQL adapter has passed parity tests.
DB_DRIVER=supabase
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=optimus
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Only needed to run the schema from the CLI (`npm run db:apply`).
# Project Settings > Database > Database password.
# SUPABASE_DB_PASSWORD=your-database-password
# Or a full connection string — use this if your network is IPv4-only and you
# need the pooler host instead of db.<ref>.supabase.co.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Challenge defaults
DAILY_DSA_TARGET=3
DAILY_LLD_TARGET=1
DAILY_HLD_TARGET=1

# Google Identity Services
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optimus question generation — OpenAI-compatible or Anthropic Messages API
LLM_PROVIDER=openai
LLM_API_KEY=
# Required for identity-linked Anthropic API keys.
LLM_WORKSPACE_ID=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Generous on purpose: writing a class, a reference implementation and a test
# suite at high effort takes minutes. Timeouts are never retried.
LLM_TIMEOUT_MS=600000

# Isolated code execution — Judge0. The public instance needs no key and is the
# default, so coding assessments work out of the box. To move to a paid or
# self-hosted judge, change the URL and add a key; nothing else changes.
#   Sulu / RapidAPI:  key goes in x-rapidapi-key (the default header)
#   self-hosted:      set JUDGE0_AUTH_HEADER=x-auth-token
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=x-rapidapi-key
JUDGE0_API_HOST=
# We are a guest on a shared judge: cap what we send it.
JUDGE0_CONCURRENCY=4
JUDGE0_BANK_CONCURRENCY=1
JUDGE0_CPU_SECONDS=5
JUDGE0_WALL_SECONDS=12
JUDGE0_MEMORY_KB=256000
# CODE_RUNNER_ENABLED=false disables coding questions entirely.

# Optimus question bank — pre-generates and verifies questions in the background
# so no student waits for a model. The worker tops up two rows every five minutes.
ASSESSMENT_WORKER_INTERVAL_MIN=5
ASSESSMENT_BANK_TOPUP=true
ASSESSMENT_BANK_TOPUP_PER_TICK=2
# Fast, bounded MCQ generation. Increase only if a provider needs more output.
ASSESSMENT_MCQ_REASONING_EFFORT=low
ASSESSMENT_MCQ_MAX_TOKENS=2200
# Background slots run in parallel, but never unbounded.
ASSESSMENT_GENERATION_CONCURRENCY=2

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# Use live_mode only for the live account; test_mode is useful for local checkout tests.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_MONTHLY_PRODUCT_ID=
DODO_ANNUAL_PRODUCT_ID=

# Transactional email — enable after Brevo sender verification.
BREVO_API_KEY=
EMAIL_TRANSPORT=api
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_SECURE=false
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM="Optimus Code <hello@example.com>"
# EMAIL_REPLY_TO=support@example.com
APP_URL=http://localhost:5173
INVITE_TOKEN_TTL_HOURS=168
STREAK_WARNING_HOUR=20
EMAIL_WORKER_INTERVAL_MIN=15

# Research pipeline — Firecrawl does search + scrape; Browser Use is the
# escalation for hosts Firecrawl refuses (Reddit).
FIRECRAWL_API_KEY=
BROWSER_USE_API_KEY=
RESEARCH_MAX_SEARCHES=8
RESEARCH_MAX_FETCHES=10
RESEARCH_CONCURRENCY=3
RESEARCH_TIMEOUT_MIN=8
RESEARCH_AUTO_PUBLISH=false

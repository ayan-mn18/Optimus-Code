# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Supabase — Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed to run the schema from the CLI (`npm run db:apply`).
# Project Settings > Database > Database password.
# SUPABASE_DB_PASSWORD=your-database-password
# Or a full connection string — use this if your network is IPv4-only and you
# need the pooler host instead of db.<ref>.supabase.co.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Challenge defaults
DAILY_DSA_TARGET=3
DAILY_LLD_TARGET=1
DAILY_HLD_TARGET=1

# Google Identity Services
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optimus question generation — any OpenAI-compatible chat completions API
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Isolated JavaScript execution — Judge0-compatible endpoint
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_MONTHLY_PRODUCT_ID=
DODO_ANNUAL_PRODUCT_ID=

# Transactional email — enable after Brevo sender verification.
BREVO_API_KEY=
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM="Optimus Code <hello@example.com>"
# EMAIL_REPLY_TO=support@example.com
APP_URL=http://localhost:5173
INVITE_TOKEN_TTL_HOURS=168
STREAK_WARNING_HOUR=20
EMAIL_WORKER_INTERVAL_MIN=15

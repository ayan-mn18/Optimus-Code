# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Supabase — Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database access. Keep `supabase` during the migration; set `native` with the
# RDS connection values only after the PostgreSQL adapter has passed parity tests.
DB_DRIVER=supabase
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=optimus
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Only needed to run the schema from the CLI (`npm run db:apply`).
# Project Settings > Database > Database password.
# SUPABASE_DB_PASSWORD=your-database-password
# Or a full connection string — use this if your network is IPv4-only and you
# need the pooler host instead of db.<ref>.supabase.co.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional admin API. Generate a NEW dedicated key with: openssl rand -hex 32
# Server-side only; blank disables /api/admin. Never put this in VITE_* variables.
ADMIN_API_KEY=

# Challenge defaults
DAILY_DSA_TARGET=3
DAILY_LLD_TARGET=1
DAILY_HLD_TARGET=1

# Google Identity Services
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optimus question generation. The endpoint must speak /chat/completions;
# anything that does not belongs behind a gateway that does.
LLM_API_KEY=
# Only for gateways that scope a key to a workspace; sent as x-workspace-id.
LLM_WORKSPACE_ID=
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3-contributor
# Multiple choice is a short structured answer and is what a student waits on;
# a coding spec is neither. Point this at a faster model to cut the wait while
# coding generation keeps the stronger one. Defaults to LLM_MODEL when unset.
LLM_FAST_MODEL=
# Generous on purpose: writing a class, a reference implementation and a test
# suite at high effort takes minutes. Timeouts are never retried. The one call
# a student waits for uses ASSESSMENT_OPENER_TIMEOUT_MS instead.
LLM_TIMEOUT_MS=600000

# Isolated code execution — Judge0. The public instance needs no key and is the
# default, so coding assessments work out of the box. To move to a paid or
# self-hosted judge, change the URL and add a key; nothing else changes.
#   Sulu / RapidAPI:  key goes in x-rapidapi-key (the default header)
#   self-hosted:      set JUDGE0_AUTH_HEADER=x-auth-token
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=x-rapidapi-key
JUDGE0_API_HOST=
# Modest on the shared public judge. On your own box these can go up: the
# self-hosted instance answers a submission in ~0.3s against ~1.2s for public CE.
JUDGE0_CONCURRENCY=4
JUDGE0_BANK_CONCURRENCY=1
JUDGE0_CPU_SECONDS=5
JUDGE0_WALL_SECONDS=12
JUDGE0_MEMORY_KB=256000
# CODE_RUNNER_ENABLED=false disables coding questions entirely.

# Optimus assessments.
#
# Nothing is pre-generated. Clicking Start draws whatever the bank already has,
# up to the draw limit, and opens the exam on it; the rest of the paper is
# written behind the student and banked as it lands, so a problem warms itself
# the first time somebody sits it. The worker below is crash recovery only.
ASSESSMENT_WORKER_INTERVAL_MIN=2
# How many ready questions the click path may draw before it answers.
ASSESSMENT_DRAW_LIMIT=3
# Fast, bounded MCQ generation. 2200 could not fit a full set and broke batching.
ASSESSMENT_MCQ_REASONING_EFFORT=minimal
ASSESSMENT_MCQ_MAX_TOKENS=3000
# Background slots are independent and issued together. Coding is the expensive
# one and gets the tighter cap.
ASSESSMENT_GENERATION_CONCURRENCY=6
ASSESSMENT_CODING_CONCURRENCY=4
# The single question generated on the request when a problem has an empty bank.
# It must never become the slow path it exists to replace.
ASSESSMENT_OPENER_TIMEOUT_MS=20000
# A coding question is a spec call then a test-suite call. The suite is the
# longer of the two; at 10000 it was being cut off and the question discarded.
ASSESSMENT_CODING_SPEC_MAX_TOKENS=12000
ASSESSMENT_CODING_TESTS_MAX_TOKENS=20000

# Optional, problem-scoped LLM experiment. Keep the API key in the encrypted
# production environment, never in Git. The override applies only to these IDs.
# ASSESSMENT_LLM_OVERRIDE_PROBLEM_IDS=
# ASSESSMENT_LLM_OVERRIDE_PROVIDER=openai
# ASSESSMENT_LLM_OVERRIDE_API_KEY=
# ASSESSMENT_LLM_OVERRIDE_BASE_URL=https://api.deepseek.com
# ASSESSMENT_LLM_OVERRIDE_MODEL=deepseek-flash
# ASSESSMENT_LLM_OVERRIDE_FAST_MODEL=deepseek-flash
# ASSESSMENT_LLM_OVERRIDE_REASONING_EFFORT=none
# ASSESSMENT_LLM_OVERRIDE_OPENER_MAX_TOKENS=2200
# ASSESSMENT_LLM_OVERRIDE_MCQ_MAX_TOKENS=3600
# How long a question stays "already seen" for one student. Without a horizon a
# regular user eventually excludes everything a problem has.
ASSESSMENT_EXPOSURE_HORIZON_DAYS=180

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# Use live_mode only for the live account; test_mode is useful for local checkout tests.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_MONTHLY_PRODUCT_ID=
DODO_ANNUAL_PRODUCT_ID=

# Transactional email — enable after Brevo sender verification.
BREVO_API_KEY=
EMAIL_TRANSPORT=api
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_SECURE=false
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM="Optimus Code <no-reply@optimusco.de>"
# Owner-facing reports and feedback are delivered here; user notifications
# continue to use the recipient's own address.
SUPPORT_EMAIL=info@optimusco.de
# EMAIL_REPLY_TO=support@example.com
APP_URL=http://localhost:5173
INVITE_TOKEN_TTL_HOURS=168
STREAK_WARNING_HOUR=20
EMAIL_WORKER_INTERVAL_MIN=15

# Research pipeline — Firecrawl does search + scrape; Browser Use is the
# escalation for hosts Firecrawl refuses (Reddit).
FIRECRAWL_API_KEY=
BROWSER_USE_API_KEY=
RESEARCH_MAX_SEARCHES=8
RESEARCH_MAX_FETCHES=10
RESEARCH_CONCURRENCY=3
RESEARCH_TIMEOUT_MIN=8
RESEARCH_AUTO_PUBLISH=false

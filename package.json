{
  "name": "optimus-code",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Optimus Code — a daily DSA challenge platform built on the Striver SDE Sheet.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint .",
    "scrape": "node scripts/scrape-sheets.js",
    "db:apply": "node scripts/db.js apply",
    "db:check": "node scripts/db.js check",
    "db:migration": "node scripts/db.js migration",
    "db:setup": "npm run db:apply && npm run seed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.13.0",
    "globals": "^17.9.0"
  }
}
